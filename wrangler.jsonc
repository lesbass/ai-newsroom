{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-06-24",
	"name": "ai-newsroom",
	"main": "src/worker.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
