---
interface Props {
  direction?: 'left' | 'right';
  className?: string;
}

const { direction = 'right', className = '' } = Astro.props;
const isLeft = direction === 'left';
---

<svg
  class:list={['icon-arrow', isLeft && 'icon-arrow-left', className]}
  viewBox="0 0 16 16"
  width="16"
  height="16"
  aria-hidden="true"
  focusable="false"
>
  {isLeft ? (
    <path
      d="M13.5 8h-11M7 3.5 2.5 8 7 12.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  ) : (
    <path
      d="M2.5 8h11M9 3.5 13.5 8 9 12.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}
</svg>
