---
import type { CollectionEntry } from 'astro:content';
import { slugifyTag } from '../lib/slugify';
import { tagLabel } from '../lib/tags';
import { formatHeadline } from '../lib/headline';

interface Props {
  article: CollectionEntry<'articles'>;
  featured?: boolean;
  headingLevel?: 2 | 3;
}

const { article, featured = false, headingLevel = 3 } = Astro.props;
const { title, description, pubDate, tags, sources } = article.data;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

// Previews must end on a word boundary: the 3-line CSS clamp otherwise cuts
// mid-word on a phone ("…withheld the mod…"). Budget the string so it fits the
// clamp at 375 px, then prefer a sentence or clause boundary for a clean end.
const CARD_TRAILING_STOPWORDS = new Set([
  'a', 'an', 'the', 'of', 'to', 'in', 'with', 'for', 'and', 'or', 'from',
  'on', 'at', 'as', 'by', 'but', 'its', 'their', 'is', 'are', 'was', 'were',
  'that', 'which', 'this', 'these', 'those',
]);

function trimTrailingStopwords(text: string): string {
  let out = text.trimEnd();
  for (;;) {
    const match = out.match(/[A-Za-z]+$/);
    if (!match || !CARD_TRAILING_STOPWORDS.has(match[0].toLowerCase())) break;
    out = out.slice(0, match.index).trimEnd().replace(/[,;:—–-]$/, '').trimEnd();
  }
  return out;
}

function truncateCardDesc(text: string, maxLen = 112): string {
  if (text.length <= maxLen) return text;
  const budget = maxLen - 1;
  const cut = text.slice(0, budget + 1);
  const lastPeriod = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));
  if (lastPeriod > budget * 0.6) return text.slice(0, lastPeriod + 1);
  for (const sep of [', ', '; ', ': ', ' — ']) {
    const idx = cut.lastIndexOf(sep);
    if (idx > budget * 0.6) return trimTrailingStopwords(text.slice(0, idx)) + '…';
  }
  const lastSpace = cut.lastIndexOf(' ');
  if (lastSpace > 0) return trimTrailingStopwords(cut.slice(0, lastSpace)) + '…';
  return trimTrailingStopwords(cut) + '…';
}

const cardDescription = truncateCardDesc(description);
const url = `/articles/${article.id}/`;
const date = new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const wordCount = article.body?.split(/\s+/).filter(Boolean).length || 0;
const readingTime = Math.max(1, Math.round(wordCount / 238));

// Two chips plus the overflow count fit one line at 375 px. Showing four
// pushed the "+N" chip onto its own row on every multi-tag card, adding a
// largely empty line to each listing entry (AIN-1001).
const MOBILE_VISIBLE_TAGS = 2;
const maxTags = featured ? 8 : 5;
const displayTags = tags.slice(0, maxTags);
const extraTagCount = Math.max(0, tags.length - maxTags);
const mobileExtraTagCount = Math.max(0, tags.length - MOBILE_VISIBLE_TAGS);
const sourceCount = sources.length;
---

<div class={featured ? 'card-featured' : 'article-card'}>
  <Heading class="article-card-title">
    <a href={url} set:html={formatHeadline(title)} />
  </Heading>
  <div class="article-meta">
    <span class="meta-item">{date}</span>
    <span class="meta-item"><span class="sep-dot" aria-hidden="true">&middot;</span><span class="reading-time">{readingTime} min read</span></span>
    {sourceCount > 0 && (
      <span class="meta-item"><span class="sep-dot" aria-hidden="true">&middot;</span><span title={`${sourceCount} cited source${sourceCount !== 1 ? 's' : ''}`}>{sourceCount} source{sourceCount !== 1 ? 's' : ''}</span></span>
    )}
  </div>
  {tags.length > 0 && (
    <div style="margin-top: 0.35rem;">
      {displayTags.map((t, i) => (
        <a
          href={`/tags/${slugifyTag(t)}/`}
          class:list={['tag', i >= MOBILE_VISIBLE_TAGS && 'tag-overflow']}
        >{tagLabel(slugifyTag(t))}</a>
      ))}
      {extraTagCount > 0 && <span class="tag tag-more tag-more-wide">+{extraTagCount}</span>}
      {mobileExtraTagCount > 0 && <span class="tag tag-more tag-more-narrow">+{mobileExtraTagCount}</span>}
    </div>
  )}
  <p class="article-desc">{cardDescription}</p>
</div>
