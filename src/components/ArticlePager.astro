---
import { articlePageHref } from '../lib/pagination';

interface Props {
  page: number;
  pages: number;
}

const { page, pages } = Astro.props;
const prevHref = page > 1 ? articlePageHref(page - 1) : null;
const nextHref = page < pages ? articlePageHref(page + 1) : null;
---

{pages > 1 && (
  <nav class="pager" aria-label="Article archive pagination">
    <div class="pager-controls">
      {prevHref ? (
        <a class="pager-link pager-prev" href={prevHref} rel="prev">
          <span class="pager-chevron" aria-hidden="true"></span>Newer
        </a>
      ) : (
        <span class="pager-link pager-prev pager-disabled" aria-disabled="true">
          <span class="pager-chevron" aria-hidden="true"></span>Newer
        </span>
      )}
      <span class="pager-status" aria-current="page">
        Page {page} of {pages}
      </span>
      {nextHref ? (
        <a class="pager-link pager-next" href={nextHref} rel="next">
          Older<span class="pager-chevron" aria-hidden="true"></span>
        </a>
      ) : (
        <span class="pager-link pager-next pager-disabled" aria-disabled="true">
          Older<span class="pager-chevron" aria-hidden="true"></span>
        </span>
      )}
    </div>
  </nav>
)}
