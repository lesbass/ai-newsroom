---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { slugifyTag } from '../../lib/slugify';
import { tagLabel } from '../../lib/tags';
import { TOPIC_MIN_ARTICLES } from '../../lib/topicTags';

const allArticles = await getCollection('articles');
const tagMap = new Map<string, number>();

for (const article of allArticles) {
  for (const tag of article.data.tags) {
    const slug = slugifyTag(tag);
    if (slug) {
      tagMap.set(slug, (tagMap.get(slug) ?? 0) + 1);
    }
  }
}

const sortedTags = [...tagMap.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const filteredTags = sortedTags.filter(([, count]) => count >= TOPIC_MIN_ARTICLES);
const totalArticles = allArticles.length;
---

<BaseLayout
  title="Topics"
  description={`Browse ${filteredTags.length} topics across ${totalArticles} evidence-based AI news articles.`}
>
  <Header />
  <main class="container" id="main-content" tabindex="-1">
    <div class="tag-page-header">
      <h1>Topics</h1>
      <p class="tag-page-count">{filteredTags.length} topics across {totalArticles} articles</p>
    </div>
    <div class="tags-index-grid">
      {filteredTags.map(([slug, count]) => (
        <a href={`/tags/${slug}/`} class="tag-index-card">
          <span>{tagLabel(slug)}</span>
          <span class="tag-index-count">{count}</span>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
