---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { slugifyTag } from '../../lib/slugify';
import { tagLabel } from '../../lib/tags';
import { getRelatedArticles, getTopicTagSlugs } from '../../lib/topicTags';
import { resolveImageDimensions, resolveHeroWebp } from '../../lib/ogImage';
import { formatHeadline } from '../../lib/headline';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'articles'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, author, tags, sources, highRiskClaims, canonicalURL, image, imageAlt, imageCredit } = post.data;
const date = new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updated =
  updatedDate && new Date(updatedDate).toDateString() !== new Date(pubDate).toDateString()
    ? new Date(updatedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
    : null;
// The preferred article shape starts with a dek/summary. Frontmatter
// `description` is authored for exactly that role (it also feeds the meta
// description), so surface it under the headline instead of leaving it only in
// the document head. Backticks are stripped because this is rendered as plain
// text, not Markdown.
const dek = description.replace(/`/g, '').trim();

const body = post.body || '';
const wordCount = body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 238));
const topicTagSlugs = await getTopicTagSlugs();
const topicTags = tags.filter((tag) => topicTagSlugs.has(slugifyTag(tag)));
const displayTags = topicTags.slice(0, 6);
const extraTagCount = Math.max(0, topicTags.length - 6);
// The preferred article shape already ends with an authored `## Sources`
// section. When the body carries one, rendering the frontmatter `sources` list
// in a second `Sources` aside would produce two identical H2 headings on the
// page, so only fall back to the generated list when the body has none.
const bodyHasSources = /^#{1,6}\s+Sources\s*$/im.test(body);
const headlineClass = title.length > 60 ? 'headline-long' : title.length > 45 ? 'headline-medium' : 'headline-short';
const heroDimensions = image && image !== 'exception' ? resolveImageDimensions(image) : null;
const heroWebp = image && image !== 'exception' ? resolveHeroWebp(image) : null;
// "In this article" navigation. Articles use a fixed H2 section shape
// (What happened / Why it matters / Practical implications / Risks and caveats
// / What to watch), so a compact list of those sections lets readers scan and
// jump on mobile, where a long single column is hardest to navigate. Only the
// body H2s are listed; the authored `Sources` section is a reference list, not
// a section to navigate to, so it is excluded. Rendered collapsed (see
// `article-toc`) so it never pushes the article body below the fold.
const tocHeadings = headings
  .filter((h) => h.depth === 2 && h.text.trim().toLowerCase() !== 'sources')
  .map((h) => ({ slug: h.slug, text: h.text }));

const allArticles = await getCollection('articles');
const relatedArticles = getRelatedArticles(post, allArticles, topicTagSlugs, 3);
const formatRelatedDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title={title}
  description={description}
  image={image === 'exception' ? undefined : image}
  imageAlt={image === 'exception' ? undefined : imageAlt}
  pubDate={pubDate}
  updatedDate={updatedDate || pubDate}
  author={author}
  article={true}
  canonicalURL={canonicalURL}
  tags={tags}
  wordCount={wordCount}
  section={topicTags[0] ? tagLabel(slugifyTag(topicTags[0])) : tags[0]}
>
  <Header />
  <main id="main-content">
  <article class="container article-body" data-image-policy={image === 'exception' ? 'exception' : undefined}>
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Articles', href: '/articles/' },
      ]}
      current={title}
    />
    <div class="article-header">
      <h1 class={headlineClass} set:html={formatHeadline(title)} />
      {dek && dek !== title && <p class="article-dek">{dek}</p>}
      <div class="article-meta">
        <span class="meta-item meta-item-date">{date}{updated && <span> (updated {updated})</span>}</span>
        <span class:list={['meta-item', 'meta-author', author === 'AI Newsroom' && 'meta-author-brand']}><span class="sep-dot" aria-hidden="true">&middot;</span><span>{author}</span></span>
        <span class="meta-item"><span class="sep-dot" aria-hidden="true">&middot;</span><span class="reading-time">{readingTime} min read</span></span>
        {sources.length > 0 && (
          <span class="meta-item"><span class="sep-dot" aria-hidden="true">&middot;</span><span>{sources.length} source{sources.length !== 1 ? 's' : ''}</span></span>
        )}
      </div>
      <div style="margin-top: 0.5rem;">
        {displayTags.map(t => <a href={`/tags/${slugifyTag(t)}/`} class="tag">{tagLabel(slugifyTag(t))}</a>)}
        {extraTagCount > 0 && <span class="tag">+{extraTagCount}</span>}
        {highRiskClaims && <a href="/editorial-standards/#high-risk-claims" class="tag tag-highlight" title="What the High-Risk Claims label means">High-Risk Claims</a>}
      </div>
    </div>
    {image && image !== 'exception' && (
      <figure class="article-hero">
        {heroWebp ? (
          <picture>
            <source type="image/webp" srcset={heroWebp.srcset} sizes={heroWebp.sizes} />
            <img src={image} alt={imageAlt || title} loading="eager" fetchpriority="high" width={heroDimensions?.width} height={heroDimensions?.height} />
          </picture>
        ) : (
          <img src={image} alt={imageAlt || title} loading="eager" fetchpriority="high" width={heroDimensions?.width} height={heroDimensions?.height} />
        )}
        {imageCredit && <figcaption class="article-hero-credit">{imageCredit}</figcaption>}
      </figure>
    )}
    {tocHeadings.length >= 3 && (
      <nav class="article-toc" aria-label="In this article">
        <details>
          <summary>In this article</summary>
          <ol>
            {tocHeadings.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </details>
      </nav>
    )}
    <Content />
    {sources.length > 0 && !bodyHasSources && (
      <aside style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
        <h2 style="font-size: 1.125rem; margin-bottom: 0.75rem;">Sources</h2>
        <ul class="sources-list">
          {sources.map(source => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
              {source.date && <span style="color: var(--color-muted);"> ({new Date(source.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })})</span>}
              {source.type === 'secondary' && <span class="source-type"> [secondary]</span>}
            </li>
          ))}
        </ul>
      </aside>
    )}
    {relatedArticles.length > 0 && (
      <aside class="related-articles" aria-labelledby="related-articles-heading">
        <h2 id="related-articles-heading">Related articles</h2>
        <ul class="related-list">
          {relatedArticles.map(({ article, sharedTags }) => (
            <li class="related-item">
              <a class="related-link" href={`/articles/${article.id}/`}>{article.data.title}</a>
              <span class="related-meta">
                <time datetime={article.data.pubDate.toISOString()}>{formatRelatedDate(article.data.pubDate)}</time>
                <span class="related-topics">{sharedTags.map(tagLabel).join(' · ')}</span>
              </span>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
  </main>
  <Footer />
</BaseLayout>
