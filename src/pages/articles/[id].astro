---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { slugifyTag } from '../../lib/slugify';
import { tagLabel } from '../../lib/tags';
import { resolveImageDimensions, resolveHeroWebp } from '../../lib/ogImage';
import { formatHeadline } from '../../lib/headline';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map((post) => ({
    params: { id: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'articles'>;

const post = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, tags, sources, highRiskClaims, canonicalURL, image, imageAlt, imageCredit } = post.data;
const date = new Date(pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const updated = updatedDate ? new Date(updatedDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : null;

const body = post.body || '';
const wordCount = body.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 238));
const displayTags = tags.slice(0, 6);
const extraTagCount = Math.max(0, tags.length - 6);
// The preferred article shape already ends with an authored `## Sources`
// section. When the body carries one, rendering the frontmatter `sources` list
// in a second `Sources` aside would produce two identical H2 headings on the
// page, so only fall back to the generated list when the body has none.
const bodyHasSources = /^#{1,6}\s+Sources\s*$/im.test(body);
const headlineClass = title.length > 60 ? 'headline-long' : title.length > 45 ? 'headline-medium' : 'headline-short';
const heroDimensions = image && image !== 'exception' ? resolveImageDimensions(image) : null;
const heroWebp = image && image !== 'exception' ? resolveHeroWebp(image) : null;
---

<BaseLayout
  title={title}
  description={description}
  image={image === 'exception' ? undefined : image}
  imageAlt={image === 'exception' ? undefined : imageAlt}
  pubDate={pubDate}
  updatedDate={updatedDate || pubDate}
  author={author}
  article={true}
  canonicalURL={canonicalURL}
  tags={tags}
>
  <Header />
  <main id="main-content">
  <article class="container article-body" data-image-policy={image === 'exception' ? 'exception' : undefined}>
    <Breadcrumb
      items={[
        { label: 'Home', href: '/' },
        { label: 'Articles', href: '/articles/' },
      ]}
      current={title}
    />
    <div class="article-header">
      <h1 class={headlineClass} set:html={formatHeadline(title)} />
      <div class="article-meta">
        <span class="meta-item">{date}{updated && <span> (updated {updated})</span>}</span>
        <span class:list={['meta-item', 'meta-author', author === 'AI Newsroom' && 'meta-author-brand']}><span class="sep-dot" aria-hidden="true">&middot;</span><span>{author}</span></span>
        <span class="meta-item"><span class="sep-dot" aria-hidden="true">&middot;</span><span class="reading-time">{readingTime} min read</span></span>
        {sources.length > 0 && (
          <span class="meta-item"><span class="sep-dot" aria-hidden="true">&middot;</span><span>{sources.length} source{sources.length !== 1 ? 's' : ''}</span></span>
        )}
      </div>
      <div style="margin-top: 0.5rem;">
        {displayTags.map(t => <a href={`/tags/${slugifyTag(t)}/`} class="tag">{tagLabel(slugifyTag(t))}</a>)}
        {extraTagCount > 0 && <span class="tag">+{extraTagCount}</span>}
        {highRiskClaims && <a href="/editorial-standards/#high-risk-claims" class="tag tag-highlight" title="What the High-Risk Claims label means">High-Risk Claims</a>}
      </div>
    </div>
    {image && image !== 'exception' && (
      <figure class="article-hero">
        {heroWebp ? (
          <picture>
            <source type="image/webp" srcset={heroWebp.srcset} sizes={heroWebp.sizes} />
            <img src={image} alt={imageAlt || title} loading="eager" fetchpriority="high" width={heroDimensions?.width} height={heroDimensions?.height} />
          </picture>
        ) : (
          <img src={image} alt={imageAlt || title} loading="eager" fetchpriority="high" width={heroDimensions?.width} height={heroDimensions?.height} />
        )}
        {imageCredit && <figcaption class="article-hero-credit">{imageCredit}</figcaption>}
      </figure>
    )}
    <Content />
    {sources.length > 0 && !bodyHasSources && (
      <aside style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
        <h2 style="font-size: 1.125rem; margin-bottom: 0.75rem;">Sources</h2>
        <ul class="sources-list">
          {sources.map(source => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
              {source.date && <span style="color: var(--color-muted);"> ({new Date(source.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })})</span>}
              {source.type === 'secondary' && <span class="source-type"> [secondary]</span>}
            </li>
          ))}
        </ul>
      </aside>
    )}
  </article>
  </main>
  <Footer />
</BaseLayout>
